class Solution {
    public int characterReplacement(String s, int k) {
        int[] freq = new int[26];   // hash array: count of each letter in window
        int left = 0;
        int maxFreq = 0;            // count of the most frequent char seen in any window so far
        int maxLength = 0;

        for (int right = 0; right < s.length(); right++) {
            char c = s.charAt(right);
            freq[c - 'A']++;                          // add new char to window
            maxFreq = Math.max(maxFreq, freq[c - 'A']); // update most frequent count

            int windowLength = right - left + 1;

            // if replacements needed > k, shrink from the left
            if (windowLength - maxFreq > k) {
                freq[s.charAt(left) - 'A']--;
                left++;
            }

            // window is valid now (or was never invalid) — record its length
            maxLength = Math.max(maxLength, right - left + 1);
        }

        return maxLength;
    }
}
