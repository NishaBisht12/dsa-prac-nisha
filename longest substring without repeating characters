class Solution {
    public int lengthOfLongestSubstring(String s) {
        char[] arr = s.toCharArray();
        int[] hash = new int[256];
        Arrays.fill(hash, -1);       // fill once, before the loop

        int n = arr.length;
        int left = 0;
        int right = 0;
        int maxLen = 0;

        while (right < n) {
            if (hash[arr[right]] != -1) {
                if (hash[arr[right]] >= left) {
                    left = hash[arr[right]] + 1;   // fixed: +1 outside the mailbox lookup
                }
            }

            int len = right - left + 1;
            maxLen = Math.max(len, maxLen);

            hash[arr[right]] = right;
            right++;
        }

        return maxLen;
    }
}
